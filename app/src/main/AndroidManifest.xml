<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".main.MainApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BookshopTracker">

        <!-- Launcher Activity: MainMenuView -->
        <activity
            android:name=".views.mainmenu.MainMenuView"
            android:exported="true"
            android:theme="@style/Theme.App.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".views.bookshop.BookshopView"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".views.bookshoplist.BookshopListView"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".views.booktracker.BookTrackerView"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".views.settings.SettingsView"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".views.allbooks.AllBooksView"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".views.mappicker.MapPickerView"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".views.maplist.MapListView"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>